# Modelo do .env da API. Copie e preencha com os valores de verdade:
#   cp .env.example .env
# O .env NAO vai para o Git (ele guarda segredos); este .env.example vai.
#
# ARQUIVO UNICO: existe um .env so, e ele aponta para o Supabase. Nao ha mais
# um .env.producao separado — os comandos que apagam dados (db:seed, db:reset,
# db:migrate, testar:api) passam pelo scripts/confirmar-producao.mjs, que
# exige PERMITIR_PRODUCAO=1 quando o banco nao e localhost.

# Porta em que a API sobe. O front usa a 3000, entao a API usa a 3333.
PORT=3333

# Endereco do front que tem permissao de chamar esta API pelo navegador.
# Varios enderecos podem ser separados por virgula. Para abrir o site no
# celular pela rede local, acrescente http://<ip-do-notebook>:3000.
# No deploy isto vira o endereco da Vercel.
CORS_ORIGIN=http://localhost:3000

# Conexao do Supabase, pelo Session pooler (porta 5432 do host
# aws-0-<regiao>.pooler.supabase.com). Use o pooler, e nao a conexao direta:
# a direta e IPv6 em projetos novos, e maquina sem IPv6 da timeout silencioso
# que parece "senha errada".
# Formato: postgres://USUARIO:SENHA@ENDERECO:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres.<ref-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Usada pelas migrations e pelo seed (a ferramenta do Prisma), enquanto a
# DATABASE_URL e usada pela API no ar. Podem ser iguais; ficam separadas
# porque migration e conexao de aplicacao tem exigencias diferentes.
DIRECT_URL=postgres://postgres.<ref-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Chave que assina o token de login do dono (JWT). Tem que ser longa e
# aleatoria de verdade — com ela, qualquer um forja o cracha da Nane. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64-caracteres-aleatorios-gerados-pelo-comando-acima>
JWT_EXPIRES_IN=7d

# Ligue com "true" APENAS quando a API estiver atras de um proxy (Render,
# Vercel, nginx). E o que faz a trava de login enxergar o IP real de quem
# chamou, em vez do IP do proxy. Rodando no notebook, deixe desligado.
CONFIAR_NO_PROXY=false

# Sobressalente: o Postgres do docker-compose.yml, para trabalhar offline sem
# tocar em producao. Se usar, troque as duas URLs acima por esta.
# postgres://pointdanane:pointdanane@localhost:5433/pointdanane
